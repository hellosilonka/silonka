# Copy to backend/.env for local development. Never commit filled-in credentials.
NODE_ENV=development
PORT=5000
MONGO_URI=
# Use a randomly generated secret of at least 32 characters.
JWT_SECRET=
# Public HTTPS origins are required for PayHere, including sandbox callbacks.
APP_URL=https://your-staging-domain.example
PUBLIC_API_URL=https://your-staging-domain.example
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 0 when directly exposed; 1 for the Render service in render.yaml.
TRUST_PROXY_HOPS=0

PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Catalogue and charged amounts are USD. Set the current approved rate for
# each currency returned by your DHL account: USD per 1 unit of that currency.
FX_EUR_TO_USD=
FX_LKR_TO_USD=
# Decimal fraction applied to merchandise only; 0 means no added tax.
CHECKOUT_TAX_RATE=0

GOOGLE_CLIENT_ID=
EMAIL_USER=
# Gmail app password for the configured sender account.
EMAIL_PASS=
ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DHL_MODE=sandbox
DHL_USERNAME=
DHL_PASSWORD=
DHL_ACCOUNT_NUMBER=
DHL_SHIPPER_NAME=
DHL_SHIPPER_COMPANY=
DHL_SHIPPER_PHONE=
DHL_SHIPPER_EMAIL=
DHL_SHIPPER_STREET=
DHL_SHIPPER_CITY=
DHL_SHIPPER_POSTAL=
DHL_SHIPPER_COUNTRY=LK
# Required with DHL_MODE=live. Obtain approved SOAP endpoints from DHL.
# Sandbox endpoints are selected automatically when DHL_MODE=sandbox.
DHL_RATE_ENDPOINT=
DHL_SHIPMENT_ENDPOINT=
DHL_PICKUP_ENDPOINT=
DHL_TRACK_ENDPOINT=
# Only if DHL requires an additional trusted CA, supply its PEM file path:
# NODE_EXTRA_CA_CERTS=

# Used only by the explicitly invoked, non-destructive admin/category seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
